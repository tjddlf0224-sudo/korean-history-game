rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹 — 누구나 보고, 자기 것만 쓰고, 자기 것만 지운다
    match /khg_rank/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','score','level','tier','at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 2000000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 클라우드 저장(2026-09-18) — 본인만 읽고 쓰고 지운다. 남은 볼 수 없다.
    match /khg_save/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data','xp','at','v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0;
    }

    // 문항 통계 — 쌓기만 한다. 읽기는 콘솔에서만. (지우기도 막힌 채로 둔다)
    match /khg_qstats/{doc} {
      allow read: if false;
      allow write: if request.resource.data.size() <= 24;
    }
    match /khg_progress/{doc} {
      allow read: if false;
      allow write: if request.resource.data.size() <= 24;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
